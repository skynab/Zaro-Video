---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
IndentWidth: 4
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AlwaysBreakTemplateDeclarations: Yes
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[a-z_]+>$'        # C++ standard library
    Priority: 1
  - Regex: '^<catch2/'
    Priority: 2
  - Regex: '^<(Qt|qt)'
    Priority: 3
  - Regex: '^<(libav|libsw)'
    Priority: 3
  - Regex: '^<'
    Priority: 3
  - Regex: '^"zaro/'
    Priority: 4
  - Regex: '.*'
    Priority: 5
