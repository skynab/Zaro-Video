{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "ZARO_BUILD_TESTS": "ON",
                "ZARO_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "debug",
            "inherits": "base",
            "displayName": "Debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "Debug + sanitizers",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "ZARO_SANITIZE": "ON"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_APPLOCAL_DEPS": "OFF",
                "ZARO_WARNINGS_AS_ERRORS": "OFF"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "windows-base",
            "displayName": "Windows Debug (MSVC + vcpkg)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "windows-release",
            "inherits": "windows-base",
            "displayName": "Windows Release (MSVC + vcpkg)",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        }
    ],
    "buildPresets": [
        { "name": "debug",   "configurePreset": "debug" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan",    "configurePreset": "asan" },
        { "name": "windows-debug",   "configurePreset": "windows-debug" },
        { "name": "windows-release", "configurePreset": "windows-release" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        { "name": "debug",   "inherits": "base", "configurePreset": "debug" },
        { "name": "release", "inherits": "base", "configurePreset": "release" },
        { "name": "asan",    "inherits": "base", "configurePreset": "asan" },
        { "name": "windows-debug",   "inherits": "base", "configurePreset": "windows-debug" },
        { "name": "windows-release", "inherits": "base", "configurePreset": "windows-release" }
    ],
    "packagePresets": [
        { "name": "release",         "configurePreset": "release" },
        { "name": "windows-release", "configurePreset": "windows-release" }
    ]
}
